# Variables de entorno locales (desarrollo).
# Copiar a .env y ajustar si hace falta.
#
# Con el entorno en contenedor (./scripts/dev-up.sh) este archivo sigue siendo
# la fuente de verdad, pero los scripts generan .env.container con los valores
# adaptados: DATABASE_URL apunta al contenedor de Postgres y el scheduler/worker
# quedan apagados. Ver docs/desarrollo-en-contenedor.md.

# Conexion a la base de datos LOCAL para `npm run dev` en el host.
# En contenedor se reemplaza por unjbg-dev-db:5432.
DATABASE_URL="postgresql://unjbg:unjbg_dev_password@localhost:5432/unjbg_news?schema=public"

# Clave secreta para firmar sesiones del panel admin (Fase 1).
# Generar con: openssl rand -base64 32
AUTH_SECRET=""

# Clave de la API de ingesta (con la que los adaptadores envian contenido, Fase 2+).
INGEST_API_KEY=""

# Activa el scheduler de adaptadores dentro de la app (Fase 2). false lo apaga.
ENABLE_ADAPTER_SCHEDULER=true

# --- WhatsApp / Baileys (Fase 4) ---

# Carpeta donde se guarda la sesion (credenciales del dispositivo vinculado).
# Es un volumen persistente: si se borra, hay que escanear el QR otra vez.
WA_AUTH_DIR="./.wa-auth"

# Numero con codigo de pais, solo digitos, sin + ni guiones. Se usa para el
# pairing code cuando no se puede escanear el QR. Ej: 51987654321
WA_PHONE=""

# Horas de historial a recuperar al conectar por primera vez (solo grupos).
WA_BACKFILL_HOURS=24

# Nombre que aparece en "Dispositivos vinculados" de WhatsApp. Debe parecer un
# navegador real (si se vincula con codigo, WhatsApp rechaza nombres raros).
WA_BROWSER_NAME="Google Chrome"

# Nivel de log del worker: trace | debug | info | warn | error | silent.
WA_LOG_LEVEL=warn

# Carpeta donde se guardan las imagenes descargadas de WhatsApp.
WA_MEDIA_DIR="public/media/whatsapp"

# URL publica del sitio. Se usa para metadatos (Open Graph), canonical y el
# sitemap. En produccion, el dominio real, por ejemplo https://unjbg.news
SITE_URL="http://localhost:3000"

# Apaga el worker de WhatsApp sin tocar el resto (util si no queres que el
# bot este escuchando mientras se desarrolla).
ENABLE_WHATSAPP_WORKER=true

# --- Robustez / observabilidad (Fase 7) ---
# Peticiones por minuto y por IP. Valores por defecto entre parentesis.
INGEST_RATE_LIMIT_PER_MIN=120
SEARCH_RATE_LIMIT_PER_MIN=60
# Intentos de login permitidos por IP+email dentro de la ventana (5 en 15 min).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# Nivel de log estructurado: debug | info | warn | error.
LOG_LEVEL=info
# Fallos seguidos de una fuente antes de mandar una alerta.
ALERT_AFTER_FAILURES=3
# Minutos sin corrida del scheduler para marcar la salud como degradada.
HEALTH_SCHEDULER_STALE_MIN=5
# Alertas (opcional). Webhook generico que reciba JSON y/o Telegram.
ALERT_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""