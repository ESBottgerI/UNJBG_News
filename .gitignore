# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# media procesada (volumen docker)
/public/media

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Solo .env.example se versiona (es la plantilla que copian los
# demas; sin esto, un clon nuevo no tendria con que configurar .env).
.env*
!.env.example

# sesion de WhatsApp (Baileys): credenciales del dispositivo vinculado.
# Si se pierde, hay que escanear el QR de nuevo.
.wa-auth/

# guias de agentes (no se commitean; agents/ guarda las copias)
/agents/
/AGENTS.md
/CLAUDE.md

# logs de fases (docs/plan.md si se trackea)
/docs/log-fase-*.md
/docs/arranque-fase-*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
