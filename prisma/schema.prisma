generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  WEB
  FACEBOOK
  WHATSAPP
  RSS
}

enum SourceStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum UserRole {
  ADMIN
  EDITOR
}

enum IngestStatus {
  NEW
  PROCESSED
  DISCARDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum RunStatus {
  OK
  ERROR
}

model Source {
  id                  String       @id @default(cuid())
  name                String
  type                SourceType
  url                 String?
  config              Json?
  autopublish         Boolean      @default(false)
  status              SourceStatus @default(ACTIVE)
  pollIntervalMinutes Int?
  lastRunAt           DateTime?
  lastError           String?
  // Salud de la fuente (Fase 7).
  lastSuccessAt       DateTime?
  lastDurationMs      Int?
  consecutiveFailures Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  rawItems RawItem[]
  posts    Post[]
  runs     SourceRun[]

  @@unique([name, type])
}

// Historial de corridas de un adaptador (Fase 7). Sirve para ver si una fuente
// se esta degradando y para el panel de salud del admin.
model SourceRun {
  id         String    @id @default(cuid())
  sourceId   String
  source     Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status     RunStatus @default(OK)
  fetched    Int       @default(0)
  newItems   Int       @default(0)
  duplicates Int       @default(0)
  durationMs Int?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([sourceId, startedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moderatedPosts Post[]
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  posts Post[]
}

model RawItem {
  id          String       @id @default(cuid())
  sourceId    String
  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String
  status      IngestStatus @default(NEW)
  payload     Json
  contentHash String
  title       String?
  images      Json?
  seenAt      DateTime     @default(now())
  processedAt DateTime?

  post Post?

  @@unique([sourceId, externalId])
  @@index([status, seenAt])
}

model Post {
  id          String     @id @default(cuid())
  rawItem     RawItem?   @relation(fields: [rawItemId], references: [id], onDelete: SetNull)
  rawItemId   String?    @unique
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  source      Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId    String?
  title       String
  bodyHtml    String
  imageUrl    String?
  thumbnailUrl String?
  imageMeta   Json?
  status      PostStatus @default(DRAFT)
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  publishedAt DateTime?
  moderatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Columna tsvector gestionada por trigger (Fase 5/6). Prisma la expone como
  // Unsupported porque no puede mapear tsvector; la busqueda se hace con SQL.
  searchVector Unsupported("tsvector")?
  views        Int        @default(0)

  @@index([status, publishedAt])
  @@index([status, views])
  @@index([categoryId])
  @@index([title])
  // Estos indices los crea la migracion de Fase 5 con SQL. Se declaran aqui
  // para que Prisma no los detecte como "sobrantes" y quiera borrarlos.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_title_trgm_idx")
  @@index([searchVector], type: Gin, map: "Post_searchVector_idx")
}
