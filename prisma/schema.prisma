generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  WEB
  FACEBOOK
  WHATSAPP
  RSS
}

enum SourceStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum UserRole {
  ADMIN
  EDITOR
}

enum IngestStatus {
  NEW
  PROCESSED
  DISCARDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

model Source {
  id                  String       @id @default(cuid())
  name                String
  type                SourceType
  url                 String?
  config              Json?
  autopublish         Boolean      @default(false)
  status              SourceStatus @default(ACTIVE)
  pollIntervalMinutes Int?
  lastRunAt           DateTime?
  lastError           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  rawItems RawItem[]
  posts    Post[]

  @@unique([name, type])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moderatedPosts Post[]
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  posts Post[]
}

model RawItem {
  id          String       @id @default(cuid())
  sourceId    String
  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String
  status      IngestStatus @default(NEW)
  payload     Json
  contentHash String
  title       String?
  images      Json?
  seenAt      DateTime     @default(now())
  processedAt DateTime?

  post Post?

  @@unique([sourceId, externalId])
  @@index([status, seenAt])
}

model Post {
  id          String     @id @default(cuid())
  rawItem     RawItem?   @relation(fields: [rawItemId], references: [id], onDelete: SetNull)
  rawItemId   String?    @unique
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  source      Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId    String?
  title       String
  bodyHtml    String
  imageUrl    String?
  thumbnailUrl String?
  imageMeta   Json?
  status      PostStatus @default(DRAFT)
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  publishedAt DateTime?
  moderatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  searchVector String?

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([title])
}
