generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  WEB
  FACEBOOK
  WHATSAPP
  RSS
}

enum SourceStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum UserRole {
  ADMIN
  EDITOR
}

enum IngestStatus {
  NEW
  PROCESSED
  DISCARDED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

// Registry de fuentes (Fase 0).
model Source {
  id                  String       @id @default(cuid())
  name                String
  type                SourceType
  url                 String?
  config              Json?        // Credenciales/detalles especificos por tipo de fuente
  autopublish         Boolean      @default(false)
  status              SourceStatus @default(ACTIVE)
  pollIntervalMinutes Int?         // Solo para fuentes WEB/RSS
  lastRunAt           DateTime?    // Ultima corrida del adaptador (Fase 2)
  lastError           String?      // Ultimo error de la corrida (Fase 2)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  rawItems RawItem[]
  posts    Post[]

  @@unique([name, type])
}

// Staff del panel de moderacion (Fase 1).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  moderatedPosts Post[]
}

// Secciones del sitio publico (Local, UNJBG, Regional, ...).
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  posts Post[]
}

// Payload crudo que llega de las fuentes (adaptadores) antes de ser noticia.
// externalId + sourceId son unicos => dedup entre fuentes.
model RawItem {
  id          String       @id @default(cuid())
  sourceId    String
  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String       // id del origen (post id, message id, url del articulo)
  status      IngestStatus @default(NEW)
  payload     Json         // contenido original tal como lo mando el adaptador
  contentHash String       // hash de titulo+cuerpo para dedup por contenido
  title       String?
  images      Json?        // lista de URLs crudas ([string])
  seenAt      DateTime     @default(now())
  processedAt DateTime?

  post Post?

  @@unique([sourceId, externalId])
  @@index([status, seenAt])
}

// Noticia final (luego de moderacion/pipeline). Salida al sitio publico.
model Post {
  id          String     @id @default(cuid())
  rawItem     RawItem?   @relation(fields: [rawItemId], references: [id], onDelete: SetNull)
  rawItemId   String?    @unique
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  source      Source?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId    String?
  title       String
  bodyHtml    String
  imageUrl    String?
  status      PostStatus @default(DRAFT)
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?    // quien moderó/edito la nota
  publishedAt DateTime?
  moderatedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}